[Unit]
Description=Encrypted SIHSALUS terminology backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=gidis-f1
WorkingDirectory=/home/gidis-f1/sihsalus-terminology
ExecStart=/bin/bash scripts/terminology/backup.sh /home/gidis-f1/sihsalus-terminology/.env.terminology /home/gidis-f1/terminology-backups
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=20min
UMask=0077
